# ============================================================================
# CP Live — contoh konfigurasi. SALIN ke .env lalu isi:   cp .env.example .env
# Berkas .env berisi rahasia: JANGAN di-commit, JANGAN ditempel ke chat/email.
# Nilai di bawah hanyalah PENGISI (placeholder), bukan nilai sungguhan.
#
# Membuat rahasia acak (jalankan di VPS, satu perintah per rahasia):
#     openssl rand -hex 32
# ============================================================================

# ---------- WAHA (jembatan WhatsApp) ----------
# Versi image WAHA. Awalnya "latest"; setelah uji Task 0 selesai, ganti dengan tag yang sudah diuji (kunci versi).
WAHA_TAG=latest

# Kunci API WAHA (rahasia acak). Dipakai bot untuk memanggil WAHA dan oleh Anda saat curl.
WAHA_API_KEY=GANTI_dengan_hasil_openssl_rand_hex_32

# Kunci tanda tangan webhook (rahasia acak, BERBEDA dari WAHA_API_KEY).
# Dipasang di WAHA (WHATSAPP_HOOK_HMAC_KEY) dan bot (WAHA_HMAC_KEY) dengan nilai yang sama.
WAHA_HMAC_KEY=GANTI_dengan_hasil_openssl_rand_hex_32

# Login dashboard WAHA (untuk scan QR lewat SSH tunnel). Sandi: pakai openssl rand -hex 16.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=GANTI_dengan_sandi_acak

# ---------- Bot: WhatsApp ----------
# Nama sesi WAHA. Biarkan "default" (WAHA versi gratis hanya mendukung satu sesi bernama default).
WAHA_SESSION=default

# ID grup WhatsApp "CP Live". Bentuknya 120363xxxxxxxxxx@g.us.
# Cara mendapatkannya ada di docs/panduan-vps.md bagian 4 (curl daftar grup). Isi SETELAH grup dibuat.
LIVE_GROUP_ID=120363000000000000@g.us

# (WAHA_URL, DB_PATH, DATA_DIR, dan PORT sudah diatur di docker-compose.yml; tidak perlu diisi di sini.)

# ---------- Bot: Claude (pembaca screenshot) ----------
# API key dari https://console.anthropic.com  (bentuknya sk-ant-...). Wajib ada saldo/kredit.
ANTHROPIC_API_KEY=sk-ant-GANTI_dengan_key_Anda

# ---------- Bot: Google (Sheets + Drive) ----------
# Dari Google Cloud Console > APIs & Services > Credentials > OAuth client ID bertipe "Desktop app".
GOOGLE_CLIENT_ID=GANTI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GANTI_client_secret

# Refresh token: dicetak oleh langkah google-auth di KOMPUTER Anda (bagian 5 panduan). Isi setelah itu.
GOOGLE_REFRESH_TOKEN=

# Dua ID berikut dicetak oleh setup-sheet (bagian 6 panduan). KOSONGKAN dulu, isi setelah setup-sheet selesai.
LIVE_SPREADSHEET_ID=
BUKTI_FOLDER_ID=

# ---------- Opsional ----------
# Dipakai setup-sheet saja: email owner yang ikut jadi editor proteksi sheet bila BERBEDA dari akun Google
# yang dipakai login (kalau sama, tidak perlu diisi).
# OWNER_EMAIL=owner@contoh.com

# Spreadsheet jadwal terpisah (tab "Data Jadwal" di berkas lain). Kosongkan bila jadwal ada di spreadsheet utama.
# JADWAL_SPREADSHEET_ID=
